---
import Base from '../layouts/Base.astro';
const home = import.meta.env.BASE_URL;
---
<Base title="Page not found — Hadar Cohen Duwek" description="The page you are looking for does not exist.">
  <main class="wrap" style="min-height:64vh;display:grid;place-items:center;text-align:center;padding:100px 28px">
    <div>
      <p class="eyebrow">Error 404</p>
      <h1 style="font-size:clamp(2rem,5vw,2.6rem);margin:.5rem 0 1rem">Page not found</h1>
      <p style="color:var(--muted);max-width:44ch;margin:0 auto 1.6rem">
        The page you’re looking for doesn’t exist or has moved.
      </p>
      <a class="btn primary" href={home}>← Back to home</a>
    </div>
  </main>
</Base>
